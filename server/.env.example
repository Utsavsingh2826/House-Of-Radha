PORT=5000
MONGO_URI=mongodb://localhost:27017/houseofradha
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRE=7d
NODE_ENV=development

# --- Razorpay test mode ---
# Get test keys from https://dashboard.razorpay.com/app/keys (Test Mode toggle)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP for password-reset emails ---
# Example: Gmail (use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=no-reply@houseofradha.com
FROM_NAME=House of Radha

# Frontend URL prefix for reset links. Append the token in the email:
#   ${RESET_URL}/<token>
RESET_URL=http://localhost:5173/reset-password
